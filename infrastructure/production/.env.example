API_IMAGE=registry.example.com/biobalance-api:replace-with-commit-sha
MEDIA_IMAGE=registry.example.com/biobalance-media:replace-with-commit-sha
POSTGRES_USER=biobalance_owner
POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_DB=biobalance
DATABASE_URL=postgresql://biobalance_app:replace-password@postgres:5432/biobalance
MIGRATION_DATABASE_URL=postgresql://biobalance_owner:replace-password@postgres:5432/biobalance
MFA_ENCRYPTION_KEY=replace-with-base64-32-random-bytes
API_PUBLIC_URL=https://api.example.com
ACTIVATION_URL=biobalance://activate
RECOVERY_URL=biobalance://recover
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=BioBalance <notifications@example.com>
SMTP_USER=replace
SMTP_PASSWORD=replace
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
