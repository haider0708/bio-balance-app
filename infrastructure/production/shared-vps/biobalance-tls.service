[Unit]
Description=Renew only the BioBalance certificate on the shared Apache host
After=apache2.service network-online.target
Wants=network-online.target
# The host's own certbot (other sites) can hold Certbot's lock at the same minute: try again a few
# times instead of staying failed until the next run twelve hours later (the alert of 2026-11-11).
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
# The existing Certbot deploy hook validates and reloads Apache. Its renewal
# configuration retains the webroot challenge and the owned API hostname.
ExecStart=/usr/bin/certbot renew --cert-name api.galylio.com --non-interactive --quiet
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5min
UMask=0077
