COMPOSE_FILE=/opt/biobalance/infrastructure/production/compose.yml
COMPOSE_ENV_FILE=/etc/biobalance/backend.env
COMPOSE_PROJECT_NAME=biobalance
BACKUP_DIR=/srv/biobalance-backups
BACKUP_MAX_BYTES=4294967296
BACKUP_FREE_BYTES=10737418240
BACKUP_DAILY_DAYS=7
BACKUP_WEEKLY_WEEKS=4
# go2code shared VPS only:
# COMPOSE_OVERRIDE_FILE=/opt/biobalance/infrastructure/production/shared-vps/compose.override.yml
# PUBLIC_HEALTH_URL=https://api.galylio.com/health
# TLS_CERTIFICATE_FILE=/etc/letsencrypt/live/api.galylio.com/fullchain.pem
