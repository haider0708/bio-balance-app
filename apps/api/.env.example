NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://biobalance_app:local-app-only@localhost:54329/biobalance
# Where uploaded photos, documents and videos are stored.
MEDIA_ROOT=../../.volumes/media
# Email (Mailpit in development: http://localhost:8029).
SMTP_HOST=127.0.0.1
SMTP_PORT=1029
SMTP_FROM=BioBalance <no-reply@localhost>
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts the admin's authenticator secret.
MFA_ENCRYPTION_KEY=
# Apple push alerts (optional): the key from developer.apple.com → Keys, as base64 of the .p8 file.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=XYZ987TEAM
# APNS_KEY_P8=
# APNS_TOPIC=tn.biobalance.app
