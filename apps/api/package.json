{
  "name": "@biobalance/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "npm run build && node --env-file=.env dist/worker.js",
    "test": "vitest run test/domain.test.ts test/database-retry.test.ts test/test-database.test.ts",
    "test:integration": "vitest run test/integration.test.ts test/query-regressions.test.ts test/operational-refinements.test.ts --maxWorkers=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "contract": "npm run build && node dist/openapi.js",
    "test:mobile-sync": "npm run build && node test/mobile-sync.cjs",
    "test:media": "vitest run test/media.test.ts --maxWorkers=1",
    "test:contracts": "npm run build && node test/contract-http.cjs",
    "test:notifications": "vitest run test/notifications.test.ts --maxWorkers=1",
    "test:journeys": "npm run build && node test/journeys.cjs",
    "test:android-restart": "npm run build && node test/restart.cjs",
    "test:audit": "vitest run test/audit.test.ts --maxWorkers=1",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:security": "vitest run test/security.test.ts test/final-audit.test.ts --maxWorkers=1",
    "test:email": "vitest run test/email.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.44.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pg": "^8.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
