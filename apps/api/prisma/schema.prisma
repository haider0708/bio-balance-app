// BioBalance v2 — regions, approvals, stock, restocks, sales, rewards and wallet.
// Row-level security (see migrations) isolates the three regions from each other.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESPONSABLE
  VENDEUR
  /// Runs the supply side: sees the paras, prepares orders for the admin to approve, ships and delivers.
  ORDERS
  /// Places the orders of one para (and receives them): no sales, no wallet. A vendeur can do the same with `canOrder`.
  ACHETEUR
}

/// Lifecycle of an account, group or point of sale. PENDING waits for the admin.
enum Status {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Approval {
  PENDING
  APPROVED
  REJECTED
}

enum LocationKind {
  PDV
  DEPOT
}

/// What a responsable goes to do at a place.
enum VisitKind {
  COUNT
  DELIVERY
  TRAINING
  FOLLOW_UP
  OTHER
}

enum VisitStatus {
  PLANNED
  ON_SITE
  DONE
  MISSED
  CANCELLED
}

enum VisitEventKind {
  CHECK_IN
  CHECK_OUT
}

/// What the position given at a check-in says about being at the place.
enum PresenceVerdict {
  VERIFIED
  OUT_OF_RANGE
  NO_FIX
  NO_POSITION
  SANDBOX
}

/// A transfer of products between two paras of the same group, waiting for the admin.
enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// What the person who made it meant: SEND (I send) or REQUEST (I need).
enum TransferDirection {
  SEND
  REQUEST
}

/// A return: a quantity taken out of a para's stock, asked by its responsable and decided by the admin.
enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// What a return does to stock: REMOVE takes quantities out of a para; MOVE takes them out and puts
/// them into another para at once; ADD only puts them in (admin only).
enum ReturnAction {
  REMOVE
  MOVE
  ADD
}

enum DeclarationKind {
  INITIAL
  COUNT
}

enum OrderStatus {
  REQUESTED
  ASSIGNED
  SHIPPED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  GROSSISTE
  BIOBALANCE
}

enum SaleStatus {
  ACTIVE
  VOIDED
}

enum RuleScope {
  PRODUCT
  FAMILY
}

enum WalletKind {
  SALE
  CORRECTION
  PAYOUT
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MediaPurpose {
  PRODUCT
  PROOF
  TRAINING
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  ARTICLE
  VIDEO
  PDF
}

// ───────────────────────────── Identity ─────────────────────────────

/// A region of the network. Regions are stable; the admin names them, and moves stores, groups,
/// grossistes and responsables between them.
model Region {
  id      String  @id @default(uuid()) @db.Uuid
  /// Internal, generated from the name when the region is created; never shown.
  code    String  @unique
  name    String
  /// The test region of the store reviewers' accounts (at most one): hidden from the admin unless
  /// asked for, and nothing done in it reaches the real network.
  sandbox Boolean @default(false)
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  phone              String?
  /// Null until the person accepts the invitation and chooses a password.
  passwordHash       String?
  role               Role
  status             Status    @default(PENDING)
  /// Responsables and vendeurs belong to exactly one region.
  regionId           String?   @db.Uuid
  /// A vendeur works in one point of sale.
  pdvId              String?   @db.Uuid
  locale             String    @default("fr")
  mfaSecret          String?
  lastTotpStep       BigInt    @default(-1)
  /// A responsable the admin lets suggest the grossiste of a restock (when the global switch is on).
  canChooseSupplier  Boolean   @default(false)
  /// A vendeur who also places the orders of the para (an ACHETEUR always does).
  canOrder           Boolean   @default(false)
  /// The password was generated and sent to the person: they must choose their own before anything else.
  mustChangePassword Boolean   @default(false)
  /// When that temporary password stops working.
  passwordExpiresAt  DateTime?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  decidedById        String?   @db.Uuid
  decidedAt          DateTime?
  decisionNote       String?

  @@index([role, status])
  @@index([regionId, role, status])
  @@index([pdvId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A phone that receives Apple push alerts for one signed-in session.
model PushDevice {
  /// The device token Apple gave the phone (hexadecimal).
  token     String   @id
  userId    String   @db.Uuid
  /// Removed with its session (a foreign key in the migration).
  sessionId String   @db.Uuid
  /// IOS.
  platform  String
  /// Builds made from Xcode talk to Apple's test servers.
  sandbox   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([sessionId])
}

/// Single-use capability sent by email: account activation or password reset.
model AccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model LoginAttempt {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ───────────────────────────── Structure ─────────────────────────────

model Group {
  id           String    @id @default(uuid()) @db.Uuid
  regionId     String    @db.Uuid
  name         String
  status       Status    @default(PENDING)
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  decidedById  String?   @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  @@index([regionId, status])
}

/// A point of sale (PDV): one parapharmacy.
model Pdv {
  id                String    @id @default(uuid()) @db.Uuid
  regionId          String    @db.Uuid
  groupId           String?   @db.Uuid
  name              String
  address           String
  city              String
  phone             String?
  status            Status    @default(PENDING)
  createdById       String    @db.Uuid
  createdAt         DateTime  @default(now())
  decidedById       String?   @db.Uuid
  decidedAt         DateTime?
  decisionNote      String?
  /// Where the place is (set once on site by the responsable, corrected by the admin): the visits are checked against it.
  latitude          Float?
  longitude         Float?
  positionAccuracyM Float?
  positionSetById   String?   @db.Uuid
  positionSetAt     DateTime?
  /// The admin locked it: the responsable cannot move it.
  positionLocked    Boolean   @default(false)

  @@index([regionId, status])
  @@index([groupId])
}

/// A grossiste's depot. Created by the admin together with the account.
/// A grossiste: a warehouse of a region that holds stock. It has no account; the
/// admin and the region's responsable manage it and its stock.
model Depot {
  id                String    @id @default(uuid()) @db.Uuid
  regionId          String    @db.Uuid
  name              String
  address           String
  city              String
  phone             String?
  /// One to five photos of the warehouse (media ids), shown on its page.
  photoIds          String[]  @default([]) @db.Uuid
  status            Status    @default(ACTIVE)
  createdAt         DateTime  @default(now())
  /// Where the place is (set once on site by the responsable, corrected by the admin): the visits are checked against it.
  latitude          Float?
  longitude         Float?
  positionAccuracyM Float?
  positionSetById   String?   @db.Uuid
  positionSetAt     DateTime?
  /// The admin locked it: the responsable cannot move it.
  positionLocked    Boolean   @default(false)

  @@index([regionId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  reference    String   @unique
  name         String
  barcode      String?  @unique
  /// Family (shampoo, serum…): rewards can be set per family.
  family       String   @default("")
  range        String   @default("")
  packageSize  String   @default("")
  description  String   @default("")
  instructions String   @default("")
  ingredients  String   @default("")
  precautions  String   @default("")
  imageId      String?  @db.Uuid
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@index([family])
  @@index([active, name])
}

// ───────────────────────────── Stock ─────────────────────────────

/// Quantity of a product at a point of sale or a depot. No lots, no expiry.
model Stock {
  locationId   String       @db.Uuid
  productId    String       @db.Uuid
  locationKind LocationKind
  /// The region that owns the stock: a point of sale's, or the grossiste's.
  regionId     String?      @db.Uuid
  quantity     Int          @default(0)
  updatedAt    DateTime     @default(now()) @updatedAt

  @@id([locationId, productId])
  @@index([regionId])
}

/// Append-only history of every quantity change.
model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  locationId   String       @db.Uuid
  productId    String       @db.Uuid
  locationKind LocationKind
  regionId     String?      @db.Uuid
  delta        Int
  /// DECLARATION, RECEIPT, SHIPMENT, SALE, SALE_CORRECTION, TRANSFER_OUT, TRANSFER_IN, RETURN_OUT, RETURN_IN, ADJUSTMENT
  reason       String
  refType      String
  refId        String       @db.Uuid
  actorId      String?      @db.Uuid
  createdAt    DateTime     @default(now())

  @@index([locationId, productId, createdAt])
  @@index([refType, refId])
}

/// Stock counted by a responsable or the admin with photos; the admin approves a responsable's count.
model StockDeclaration {
  id           String                 @id @default(uuid()) @db.Uuid
  kind         DeclarationKind
  locationId   String                 @db.Uuid
  locationKind LocationKind
  regionId     String?                @db.Uuid
  status       Approval               @default(PENDING)
  photoId      String?                @db.Uuid
  /// One to five photos of the counted stock; photoId is the first.
  photoIds     String[]               @default([]) @db.Uuid
  note         String?
  createdById  String                 @db.Uuid
  createdAt    DateTime               @default(now())
  decidedById  String?                @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  /// The responsable correcting a waiting count: the admin cannot decide it until they finish (or the hold ends).
  editingById  String?                @db.Uuid
  editingUntil DateTime?
  /// Counts the saves of a count: a form opened before another save is refused (nobody overwrites anyone).
  revision     Int                    @default(0)
  /// When the responsable last corrected the count after its approval.
  correctedAt  DateTime?
  lines        StockDeclarationLine[]

  @@index([status, createdAt])
  @@index([locationId, status])
  @@index([regionId, status])
}

model StockDeclarationLine {
  id               String           @id @default(uuid()) @db.Uuid
  declarationId    String           @db.Uuid
  productId        String           @db.Uuid
  quantity         Int
  /// What the admin approved; null until decided.
  approvedQuantity Int?
  /// How much this line has put into the place's stock so far (null: nothing yet, a count
  /// declared before counts applied at once). Changes apply the difference to this number.
  appliedQuantity  Int?
  /// A product the admin added when approving (it was not in the responsable's count).
  addedByAdmin     Boolean          @default(false)
  /// The place of the line in the list as it was entered (null: sorted by name after the others).
  position         Int?
  declaration      StockDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@unique([declarationId, productId])
}

// ───────────────────────────── Restocks ─────────────────────────────

model RestockOrder {
  id               String        @id @default(uuid()) @db.Uuid
  /// RS-2026-000001
  number           String        @unique
  /// Region of the destination: a point of sale's, or the grossiste's.
  regionId         String?       @db.Uuid
  destKind         LocationKind
  destId           String        @db.Uuid
  status           OrderStatus   @default(REQUESTED)
  source           OrderSource?
  supplierDepotId  String?       @db.Uuid
  /// The region the goods leave from (the grossiste's): its responsable ships the order.
  supplierRegionId String?       @db.Uuid
  /// The grossiste the responsable suggested; the admin decides.
  suggestedDepotId String?       @db.Uuid
  requestedById    String        @db.Uuid
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  assignedAt       DateTime?
  shippedAt        DateTime?
  /// The responsable, or the team member chosen by them, who confirms the delivery with its paper.
  receiverId       String?       @db.Uuid
  receiptPhotoId   String?       @db.Uuid
  receiptPhotoIds  String[]      @default([]) @db.Uuid
  receivedAt       DateTime?
  decidedById      String?       @db.Uuid
  decidedAt        DateTime?
  /// What the receiver wrote when confirming the delivery.
  receiptNote      String?
  decisionNote     String?
  cancelReason     String?
  /// The order manager's proposal on a waiting order: where it should come from; the admin approves it.
  proposedSource   OrderSource?
  proposedDepotId  String?       @db.Uuid
  proposedById     String?       @db.Uuid
  proposedAt       DateTime?
  proposalNote     String?
  /// Papers added by the order manager or the admin (preparation, shipping, delivery): media ids.
  documentIds      String[]      @default([]) @db.Uuid
  /// Handed to the place by the order manager (the place's team still confirms the receipt).
  deliveredAt      DateTime?
  deliveredById    String?       @db.Uuid
  lines            RestockLine[]

  @@index([status, createdAt])
  @@index([regionId, status])
  @@index([supplierDepotId, status])
  @@index([supplierRegionId, status])
  @@index([destId, status])
}

model RestockLine {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  productId String       @db.Uuid
  requested Int
  shipped   Int?
  received  Int?
  approved  Int?
  /// The quantity the order manager proposed (null: no proposal, or the product was not changed).
  proposed  Int?
  order     RestockOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  /// Chosen by the phone: retrying the same sale never duplicates it.
  id             String     @id @db.Uuid
  pdvId          String     @db.Uuid
  regionId       String     @db.Uuid
  sellerId       String     @db.Uuid
  occurredAt     DateTime
  /// Tunis calendar day of the sale, used for rewards and reports.
  day            DateTime   @db.Date
  units          Int
  rewardMillimes BigInt     @default(0)
  status         SaleStatus @default(ACTIVE)
  version        Int        @default(1)
  createdAt      DateTime   @default(now())
  lines          SaleLine[]

  @@index([pdvId, occurredAt])
  @@index([regionId, day])
  @@index([sellerId, occurredAt])
  @@index([day])
}

model SaleLine {
  id                 String @id @default(uuid()) @db.Uuid
  saleId             String @db.Uuid
  productId          String @db.Uuid
  quantity           Int
  /// Reward per unit when the line was recorded; corrections keep it.
  unitRewardMillimes BigInt @default(0)
  sale               Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, productId])
  @@index([productId])
}

/// Append-only: what a correction changed, by whom and why.
model SaleRevision {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  version   Int
  editorId  String   @db.Uuid
  reason    String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@unique([saleId, version])
}

// ───────────────────────────── Rewards and wallet ─────────────────────────────

/// Money per unit sold, for one product or a whole family, during a period.
model RewardRule {
  id             String    @id @default(uuid()) @db.Uuid
  scope          RuleScope
  productId      String?   @db.Uuid
  family         String?
  /// "P:<productId>" or "F:<family>": the thing the rule applies to.
  targetKey      String
  amountMillimes BigInt
  startsOn       DateTime  @db.Date
  /// Null: open-ended.
  endsOn         DateTime? @db.Date
  note           String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?
  cancelledById  String?   @db.Uuid

  @@index([targetKey, startsOn])
}

/// Append-only: a vendeur's balance is the sum of their entries.
model WalletEntry {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  kind           WalletKind
  amountMillimes BigInt
  saleId         String?    @db.Uuid
  payoutId       String?    @db.Uuid
  note           String?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model PayoutRequest {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  regionId       String       @db.Uuid
  amountMillimes BigInt
  status         PayoutStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  decidedById    String?      @db.Uuid
  decidedAt      DateTime?
  decisionNote   String?
  paidAt         DateTime?
  reference      String?

  @@index([status, createdAt])
  @@index([userId, status])
}

// ───────────────────────────── Messaging ─────────────────────────────

/// An announcement written by the admin for a chosen audience.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  authorId       String    @db.Uuid
  title          String
  body           String
  /// { all?, roles?, regionIds?, pdvIds?, userIds? }
  audience       Json
  pinned         Boolean   @default(false)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// MESSAGE (written by the admin) or SYSTEM (generated by an event).
  kind       String
  messageId  String?   @db.Uuid
  /// For SYSTEM notifications the phone translates this key.
  key        String?
  params     Json?
  title      String?
  body       String?
  pinned     Boolean   @default(false)
  entityType String?
  entityId   String?   @db.Uuid
  readAt     DateTime?
  /// When the worker handed it to the push service (or decided not to).
  pushedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([messageId])
}

// ───────────────────────────── Training ─────────────────────────────

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  summary     String       @default("")
  coverId     String?      @db.Uuid
  status      CourseStatus @default(DRAFT)
  /// { roles?: Role[], regionIds?: string[] }; empty means everyone.
  audience    Json
  position    Int          @default(0)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?
  lessons     Lesson[]

  @@index([status, position])
}

model Lesson {
  id       String     @id @default(uuid()) @db.Uuid
  courseId String     @db.Uuid
  position Int
  title    String
  kind     LessonKind
  body     String     @default("")
  mediaId  String?    @db.Uuid
  videoUrl String?
  minutes  Int?
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

model LessonProgress {
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
  @@index([lessonId])
}

// ───────────────────────────── Platform ─────────────────────────────

model MediaAsset {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  purpose   MediaPurpose
  /// For PROOF photos: the region whose responsable may look at it.
  regionId  String?      @db.Uuid
  fileName  String
  mime      String
  size      BigInt
  sha256    String
  path      String
  createdAt DateTime     @default(now())

  @@index([ownerId])
}

/// An error the app met on a phone or in the console, counted once per kind. Holds nothing that
/// identifies the person: the platform, the app version and the error itself.
model ClientError {
  id          String   @id @default(uuid()) @db.Uuid
  fingerprint String   @unique
  platform    String
  appVersion  String
  message     String
  stack       String
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([lastSeen])
}

model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  regionId  String?  @db.Uuid
  details   Json
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([regionId, createdAt])
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String
  key         String    @unique
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  leaseToken  String?   @db.Uuid
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
}

/// Permission from the admin to count a place again (used once, by the declaration it opens).
model StockRecount {
  id            String       @id @default(uuid()) @db.Uuid
  locationId    String       @db.Uuid
  locationKind  LocationKind
  regionId      String?      @db.Uuid
  requestedById String       @db.Uuid
  reason        String
  status        Approval     @default(PENDING)
  decidedById   String?      @db.Uuid
  decidedAt     DateTime?
  decisionNote  String?
  declarationId String?      @db.Uuid
  createdAt     DateTime     @default(now())
  /// RECOUNT: permission to count a place again. CORRECTION: permission to correct the count `correctsId`.
  kind          String       @default("RECOUNT")
  correctsId    String?      @db.Uuid

  @@index([status, createdAt])
  @@index([locationId, status])
}

/// A setting the admin changes from the app (JSON value per key): minimum version, hours, grossiste choice.
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?  @db.Uuid
}

/// A one-time page that shows a new administrator's authenticator QR code once, then forgets it.
model SetupLink {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  /// The authenticator link, encrypted; null once shown or expired.
  secret    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  /// A link the owner asked to keep: it can be opened again and again, and never expires.
  keep      Boolean   @default(false)

  @@index([userId])
}

// ───────────────────────────── Planning (responsables) ─────────────────────────────

/// A visit a responsable plans to a store or a grossiste of their region, and what happened on site.
model Visit {
  id             String       @id @default(uuid()) @db.Uuid
  regionId       String       @db.Uuid
  responsableId  String       @db.Uuid
  targetKind     LocationKind
  targetId       String       @db.Uuid
  kind           VisitKind
  plannedStart   DateTime
  plannedEnd     DateTime
  /// Tunis calendar day of the planned start.
  day            DateTime     @db.Date
  note           String?
  status         VisitStatus  @default(PLANNED)
  /// Made on the spot, with no plan before it.
  unplanned      Boolean      @default(false)
  /// Grows with every change, so a calendar app replaces its copy of the visit.
  revision       Int          @default(0)
  reminderSentAt DateTime?
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  events         VisitEvent[]

  @@index([responsableId, day])
  @@index([regionId, day])
  @@index([status, plannedStart])
}

/// Append-only evidence of presence: one check-in and one check-out per visit, with the position
/// given at that moment (never a trail). Kept 12 months.
model VisitEvent {
  id            String          @id @default(uuid()) @db.Uuid
  visitId       String          @db.Uuid
  regionId      String          @db.Uuid
  responsableId String          @db.Uuid
  kind          VisitEventKind
  /// The phone's clock when the person tapped.
  occurredAt    DateTime
  receivedAt    DateTime        @default(now())
  latitude      Float?
  longitude     Float?
  accuracyM     Float?
  distanceM     Int?
  verdict       PresenceVerdict
  /// MOCK_LOCATION, LATE_SYNC, LOW_ACCURACY: things to look at, not proof of anything.
  flags         String[]        @default([])
  reason        String?
  visit         Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, kind])
  @@index([responsableId, occurredAt])
  @@index([receivedAt])
}

/// The secret link a responsable adds to their calendar app (read-only, their own visits).
model CalendarFeed {
  userId    String   @id @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
}

model PlanningPreference {
  userId         String  @id @db.Uuid
  /// Minutes before a visit for the reminder (0 = none).
  leadMinutes    Int     @default(60)
  /// The evening alert about tomorrow's visits.
  eveningSummary Boolean @default(true)
}

// ───────────────────────────── Transfers between paras of a group ─────────────────────────────

/// Products moving from one para to another of the same group. The admin approves the quantities;
/// only then does the stock move. Made by the admin, it is applied at once.
model StockTransfer {
  id           String             @id @default(uuid()) @db.Uuid
  /// TR-2026-000001
  number       String             @unique
  regionId     String             @db.Uuid
  groupId      String             @db.Uuid
  fromPdvId    String             @db.Uuid
  toPdvId      String             @db.Uuid
  direction    TransferDirection
  status       TransferStatus     @default(PENDING)
  createdById  String             @db.Uuid
  /// The one proof photo (a media id); none when the admin made it.
  photoId      String?            @db.Uuid
  note         String?
  /// Grows with every change of the quantities.
  revision     Int                @default(0)
  expiresAt    DateTime?
  decidedById  String?            @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  lines        TransferLine[]
  revisions    TransferRevision[]

  @@index([regionId, status])
  @@index([fromPdvId, status])
  @@index([toPdvId, status])
  @@index([status, expiresAt])
}

model TransferLine {
  id                String        @id @default(uuid()) @db.Uuid
  transferId        String        @db.Uuid
  productId         String        @db.Uuid
  /// What would move now.
  quantity          Int
  /// What was first asked (0 for a product added later).
  requestedQuantity Int
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
}

/// Append-only: who changed the quantities, when, from what to what.
model TransferRevision {
  id         String        @id @default(uuid()) @db.Uuid
  transferId String        @db.Uuid
  version    Int
  editorId   String        @db.Uuid
  before     Json
  after      Json
  createdAt  DateTime      @default(now())
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, version])
}

// ───────────────────────────── Returns ─────────────────────────────

/// Quantities taken out of one para's stock. A responsable asks, the admin decides (and may correct
/// the quantities); made by the admin it applies at once.
model StockReturn {
  id           String           @id @default(uuid()) @db.Uuid
  /// RT-2026-000001
  number       String           @unique
  regionId     String           @db.Uuid
  /// The para the quantities leave (REMOVE, MOVE) or enter (ADD).
  pdvId        String           @db.Uuid
  action       ReturnAction     @default(REMOVE)
  /// The para that receives them (MOVE only).
  toPdvId      String?          @db.Uuid
  status       ReturnStatus     @default(PENDING)
  createdById  String           @db.Uuid
  note         String?
  /// Grows with every change of the quantities.
  revision     Int              @default(0)
  expiresAt    DateTime?
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  lines        ReturnLine[]
  revisions    ReturnRevision[]

  @@index([regionId, status])
  @@index([pdvId, status])
  @@index([status, expiresAt])
}

model ReturnLine {
  id                String      @id @default(uuid()) @db.Uuid
  returnId          String      @db.Uuid
  productId         String      @db.Uuid
  /// What would leave now.
  quantity          Int
  /// What was first asked (0 for a product added later).
  requestedQuantity Int
  stockReturn       StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@unique([returnId, productId])
}

/// Append-only: who changed the quantities, when, from what to what.
model ReturnRevision {
  id          String      @id @default(uuid()) @db.Uuid
  returnId    String      @db.Uuid
  version     Int
  editorId    String      @db.Uuid
  before      Json
  after       Json
  createdAt   DateTime    @default(now())
  stockReturn StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@unique([returnId, version])
}
