// BioBalance v2 — regions, approvals, stock, restocks, sales, rewards and wallet.
// Row-level security (see migrations) isolates the three regions from each other.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESPONSABLE
  GROSSISTE
  VENDEUR
}

/// Lifecycle of an account, group or point of sale. PENDING waits for the admin.
enum Status {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Approval {
  PENDING
  APPROVED
  REJECTED
}

enum LocationKind {
  PDV
  DEPOT
}

enum DeclarationKind {
  INITIAL
  COUNT
}

enum OrderStatus {
  REQUESTED
  ASSIGNED
  SHIPPED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  GROSSISTE
  BIOBALANCE
}

enum SaleStatus {
  ACTIVE
  VOIDED
}

enum RuleScope {
  PRODUCT
  FAMILY
}

enum WalletKind {
  SALE
  CORRECTION
  PAYOUT
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MediaPurpose {
  PRODUCT
  PROOF
  TRAINING
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonKind {
  ARTICLE
  VIDEO
  PDF
}

// ───────────────────────────── Identity ─────────────────────────────

model Region {
  id   String @id @default(uuid()) @db.Uuid
  /// NORD, CENTRE or SUD. The three regions are fixed.
  code String @unique
  name String
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  phone        String?
  /// Null until the person accepts the invitation and chooses a password.
  passwordHash String?
  role         Role
  status       Status   @default(PENDING)
  /// Responsables and vendeurs belong to exactly one region.
  regionId     String?  @db.Uuid
  /// A vendeur works in one point of sale.
  pdvId        String?  @db.Uuid
  locale       String   @default("fr")
  mfaSecret    String?
  lastTotpStep BigInt   @default(-1)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  decidedById  String?  @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  @@index([role, status])
  @@index([regionId, role, status])
  @@index([pdvId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use capability sent by email: account activation or password reset.
model AccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model LoginAttempt {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ───────────────────────────── Structure ─────────────────────────────

model Group {
  id           String    @id @default(uuid()) @db.Uuid
  regionId     String    @db.Uuid
  name         String
  status       Status    @default(PENDING)
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  decidedById  String?   @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  @@index([regionId, status])
}

/// A point of sale (PDV): one parapharmacy.
model Pdv {
  id           String    @id @default(uuid()) @db.Uuid
  regionId     String    @db.Uuid
  groupId      String?   @db.Uuid
  name         String
  address      String
  city         String
  phone        String?
  status       Status    @default(PENDING)
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  decidedById  String?   @db.Uuid
  decidedAt    DateTime?
  decisionNote String?

  @@index([regionId, status])
  @@index([groupId])
}

/// A grossiste's depot. Created by the admin together with the account.
model Depot {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String
  address   String
  city      String
  phone     String?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Catalog ─────────────────────────────

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  reference   String   @unique
  name        String
  barcode     String?  @unique
  /// Family (shampoo, serum…): rewards can be set per family.
  family      String   @default("")
  range       String   @default("")
  packageSize String   @default("")
  description String   @default("")
  instructions String  @default("")
  ingredients String   @default("")
  precautions String   @default("")
  imageId     String?  @db.Uuid
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([family])
  @@index([active, name])
}

// ───────────────────────────── Stock ─────────────────────────────

/// Quantity of a product at a point of sale or a depot. No lots, no expiry.
model Stock {
  locationId   String       @db.Uuid
  productId    String       @db.Uuid
  locationKind LocationKind
  /// Null for depots: they are not part of a region.
  regionId     String?      @db.Uuid
  quantity     Int          @default(0)
  updatedAt    DateTime     @default(now()) @updatedAt

  @@id([locationId, productId])
  @@index([regionId])
}

/// Append-only history of every quantity change.
model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  locationId   String       @db.Uuid
  productId    String       @db.Uuid
  locationKind LocationKind
  regionId     String?      @db.Uuid
  delta        Int
  /// DECLARATION, RECEIPT, SHIPMENT, SALE, SALE_CORRECTION
  reason       String
  refType      String
  refId        String       @db.Uuid
  actorId      String?      @db.Uuid
  createdAt    DateTime     @default(now())

  @@index([locationId, productId, createdAt])
  @@index([refType, refId])
}

/// Stock entered by a responsable (or grossiste) with a photo, approved by the admin.
model StockDeclaration {
  id           String          @id @default(uuid()) @db.Uuid
  kind         DeclarationKind
  locationId   String          @db.Uuid
  locationKind LocationKind
  regionId     String?         @db.Uuid
  status       Approval        @default(PENDING)
  photoId      String          @db.Uuid
  note         String?
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now())
  decidedById  String?         @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  lines        StockDeclarationLine[]

  @@index([status, createdAt])
  @@index([locationId, status])
  @@index([regionId, status])
}

model StockDeclarationLine {
  id               String           @id @default(uuid()) @db.Uuid
  declarationId    String           @db.Uuid
  productId        String           @db.Uuid
  quantity         Int
  /// What the admin approved; null until decided.
  approvedQuantity Int?
  declaration      StockDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@unique([declarationId, productId])
}

// ───────────────────────────── Restocks ─────────────────────────────

model RestockOrder {
  id             String      @id @default(uuid()) @db.Uuid
  /// RS-2026-000001
  number         String      @unique
  /// Region of the destination point of sale; null when the destination is a depot.
  regionId       String?     @db.Uuid
  destKind       LocationKind
  destId         String      @db.Uuid
  status         OrderStatus @default(REQUESTED)
  source         OrderSource?
  supplierDepotId String?    @db.Uuid
  requestedById  String      @db.Uuid
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  assignedAt     DateTime?
  shippedAt      DateTime?
  /// The responsable, or the team member chosen by them, who counts the goods.
  receiverId     String?     @db.Uuid
  receiptPhotoId String?     @db.Uuid
  receivedAt     DateTime?
  decidedById    String?     @db.Uuid
  decidedAt      DateTime?
  decisionNote   String?
  cancelReason   String?
  lines          RestockLine[]

  @@index([status, createdAt])
  @@index([regionId, status])
  @@index([supplierDepotId, status])
  @@index([destId, status])
}

model RestockLine {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  productId String       @db.Uuid
  requested Int
  shipped   Int?
  received  Int?
  approved  Int?
  order     RestockOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  /// Chosen by the phone: retrying the same sale never duplicates it.
  id            String     @id @db.Uuid
  pdvId         String     @db.Uuid
  regionId      String     @db.Uuid
  sellerId      String     @db.Uuid
  occurredAt    DateTime
  /// Tunis calendar day of the sale, used for rewards and reports.
  day           DateTime   @db.Date
  units         Int
  rewardMillimes BigInt    @default(0)
  status        SaleStatus @default(ACTIVE)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  lines         SaleLine[]

  @@index([pdvId, occurredAt])
  @@index([regionId, day])
  @@index([sellerId, occurredAt])
  @@index([day])
}

model SaleLine {
  id                 String @id @default(uuid()) @db.Uuid
  saleId             String @db.Uuid
  productId          String @db.Uuid
  quantity           Int
  /// Reward per unit when the line was recorded; corrections keep it.
  unitRewardMillimes BigInt @default(0)
  sale               Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, productId])
  @@index([productId])
}

/// Append-only: what a correction changed, by whom and why.
model SaleRevision {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  version   Int
  editorId  String   @db.Uuid
  reason    String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@unique([saleId, version])
}

// ───────────────────────────── Rewards and wallet ─────────────────────────────

/// Money per unit sold, for one product or a whole family, during a period.
model RewardRule {
  id             String    @id @default(uuid()) @db.Uuid
  scope          RuleScope
  productId      String?   @db.Uuid
  family         String?
  /// "P:<productId>" or "F:<family>": the thing the rule applies to.
  targetKey      String
  amountMillimes BigInt
  startsOn       DateTime  @db.Date
  /// Null: open-ended.
  endsOn         DateTime? @db.Date
  note           String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?
  cancelledById  String?   @db.Uuid

  @@index([targetKey, startsOn])
}

/// Append-only: a vendeur's balance is the sum of their entries.
model WalletEntry {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  kind           WalletKind
  amountMillimes BigInt
  saleId         String?    @db.Uuid
  payoutId       String?    @db.Uuid
  note           String?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model PayoutRequest {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  regionId       String       @db.Uuid
  amountMillimes BigInt
  status         PayoutStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  decidedById    String?      @db.Uuid
  decidedAt      DateTime?
  decisionNote   String?
  paidAt         DateTime?
  reference      String?

  @@index([status, createdAt])
  @@index([userId, status])
}

// ───────────────────────────── Messaging ─────────────────────────────

/// An announcement written by the admin for a chosen audience.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  authorId       String    @db.Uuid
  title          String
  body           String
  /// { all?, roles?, regionIds?, pdvIds?, userIds? }
  audience       Json
  pinned         Boolean   @default(false)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// MESSAGE (written by the admin) or SYSTEM (generated by an event).
  kind       String
  messageId  String?   @db.Uuid
  /// For SYSTEM notifications the phone translates this key.
  key        String?
  params     Json?
  title      String?
  body       String?
  pinned     Boolean   @default(false)
  entityType String?
  entityId   String?   @db.Uuid
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, messageId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([messageId])
}

// ───────────────────────────── Training ─────────────────────────────

model Course {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  summary     String       @default("")
  coverId     String?      @db.Uuid
  status      CourseStatus @default(DRAFT)
  /// { roles?: Role[], regionIds?: string[] }; empty means everyone.
  audience    Json
  position    Int          @default(0)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?
  lessons     Lesson[]

  @@index([status, position])
}

model Lesson {
  id       String     @id @default(uuid()) @db.Uuid
  courseId String     @db.Uuid
  position Int
  title    String
  kind     LessonKind
  body     String     @default("")
  mediaId  String?    @db.Uuid
  videoUrl String?
  minutes  Int?
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

model LessonProgress {
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
  @@index([lessonId])
}

// ───────────────────────────── Platform ─────────────────────────────

model MediaAsset {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  purpose   MediaPurpose
  /// For PROOF photos: the region whose responsable may look at it.
  regionId  String?      @db.Uuid
  fileName  String
  mime      String
  size      BigInt
  sha256    String
  path      String
  createdAt DateTime     @default(now())

  @@index([ownerId])
}

model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String
  regionId  String?  @db.Uuid
  details   Json
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([regionId, createdAt])
}

model Job {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String
  key        String   @unique
  payload    Json
  status     String   @default("pending")
  attempts   Int      @default(0)
  availableAt DateTime @default(now())
  lockedAt   DateTime?
  leaseToken String?  @db.Uuid
  lastError  String?
  createdAt  DateTime @default(now())

  @@index([status, availableAt])
}
